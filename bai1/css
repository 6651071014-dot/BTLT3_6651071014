<style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            /* Dùng font Segoe UI hoặc Arial cho phần thân bản tin */
            font-family: 'Segoe UI', Arial, sans-serif;
            background-color: #FAF7F2;
            color: #333333;
            line-height: 1.6;
        }

        /* ĐỔI FONT TẠI ĐÂY: Dùng font 'Merriweather' chuẩn tiếng Việt thay cho 'Georgia' */
        h1, h2, h3, h4 {
            font-family: 'Merriweather', 'Times New Roman', serif;
            color: #2C1810;
        }

        h2 + p {
            margin-top: 5px;
        }

        /* BANNER & HEADER */
        .hero-header {
            background-image: linear-gradient(rgba(20, 10, 5, 0.75), rgba(20, 10, 5, 0.75)), url('https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?q=80&w=1200');
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
            color: #FFFFFF;
            padding: 20px 40px 80px 40px;
            text-align: center;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 60px;
        }

        .brand {
            display: flex;
            align-items: center;
            text-decoration: none;
            color: #FFF;
        }

        .logo-img {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            margin-right: 12px;
            object-fit: cover;
        }

        .brand-name {
            font-weight: bold;
            letter-spacing: 2px;
            font-size: 1.1rem;
        }

        .btn-table {
            background-color: #C87D53;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 20px;
            cursor: pointer;
            font-weight: 600;
            transition: background 0.3s ease;
        }

        .btn-table:hover {
            background-color: #A66038;
        }

        .hero-content {
            max-width: 700px;
            margin: 0 auto;
        }

        .hero-content .welcome-text {
            font-style: italic;
            font-family: 'Merriweather', serif;
            color: #D4A373;
            font-size: 1.2rem;
        }

        .hero-content h1 {
            color: #FFFFFF;
            font-size: 3rem;
            letter-spacing: 3px;
            margin: 10px 0;
        }

        .hero-content .slogan {
            font-size: 1rem;
            color: #E0D6CC;
            font-style: italic;
        }

        /* NAVIGATION */
        .main-nav {
            background-color: #1A0D08;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .main-nav ul {
            display: flex;
            justify-content: center;
            list-style: none;
        }

        .main-nav ul li a {
            display: block;
            padding: 15px 25px;
            color: #D0C5BC;
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .main-nav ul li a:hover,
        .main-nav ul li a.active {
            color: #FFFFFF;
            background-color: #2C1810;
        }

        .main-nav ul li a.active::after {
            content: '';
            display: block;
            width: 50%;
            height: 2px;
            background-color: #C87D53;
            margin: 4px auto 0 auto;
        }

        /* MAIN & ASIDE LAYOUT */
        .main-container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
            display: flex;
            gap: 30px;
        }

        .content-area {
            flex: 3;
        }

        .sidebar {
            flex: 1;
        }

        .section-title-wrap {
            text-align: center;
            margin-bottom: 30px;
            padding: 10px;
            background-color: #EFE8DE;
            background-origin: padding-box;
            background-clip: padding-box;
            border-radius: 8px;
        }

        .section-title-wrap .sub-heading {
            font-size: 0.8rem;
            letter-spacing: 2px;
            color: #C87D53;
            font-weight: bold;
        }

        .section-title-wrap h2 {
            font-size: 2rem;
        }

        .menu-section {
            margin-bottom: 50px;
        }

        .menu-section h2 {
            font-size: 1.4rem;
            border-bottom: 2px solid #E5D9CC;
            padding-bottom: 8px;
            margin-bottom: 20px;
            color: #4A2E2B;
        }

        .grid-menu {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 20px;
        }

        .grid-menu > article.food-card {
            background: #FFFFFF;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            display: flex;
            flex-direction: column;
        }

        .grid-menu > article.food-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
        }

        .food-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 12px 12px 0 0;
        }

        .card-body {
            padding: 15px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .card-body h3 {
            font-size: 1.1rem;
            margin-bottom: 8px;
        }

        .card-body p {
            font-size: 0.85rem;
            color: #666666;
            margin-bottom: 15px;
            flex-grow: 1;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .price {
            font-weight: bold;
            color: #C87D53;
            font-size: 1rem;
        }

        .btn-order {
            background-color: #C87D53;
            color: #FFFFFF;
            border: none;
            padding: 6px 14px;
            border-radius: 15px;
            cursor: pointer;
            font-size: 0.8rem;
            transition: background 0.2s ease;
        }

        .btn-order:hover {
            background-color: #2C1810;
        }

        .aside-box {
            background-color: #FFFFFF;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 25px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.04);
        }

        .promo-box {
            border: 8px solid #C87D53;
            border-radius: 12px;
        }

        .aside-tag {
            background-color: #2C1810;
            color: #FFF;
            font-size: 0.65rem;
            padding: 3px 8px;
            border-radius: 4px;
            letter-spacing: 1px;
        }

        .promo-box h3 {
            margin: 10px 0 15px 0;
            font-size: 1.2rem;
        }

        .hot-list {
            list-style: none;
        }

        .hot-list li {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
            padding-bottom: 12px;
            border-bottom: 1px dashed #E5D9CC;
        }

        .hot-list li:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .hot-list img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
        }

        .hot-list h4 {
            font-size: 0.9rem;
        }

        .hot-list span {
            font-size: 0.75rem;
            color: #777;
            display: block;
        }

        .site-footer {
            background-image: linear-gradient(#1A0D08, #110805);
            color: #D0C5BC;
            padding: 50px 20px 20px 20px;
            margin-top: 50px;
        }

        .footer-grid {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 40px;
            padding-bottom: 40px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .footer-col h4 {
            color: #FFFFFF;
            margin-bottom: 15px;
            font-size: 1.1rem;
            letter-spacing: 1px;
        }

        .footer-col p {
            font-size: 0.9rem;
            margin-bottom: 8px;
        }

        .footer-col small {
            color: #888;
            font-size: 0.8rem;
        }

        .social-links {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .social-links a {
            color: #FFFFFF;
            background-color: rgba(255, 255, 255, 0.1);
            padding: 6px 12px;
            border-radius: 4px;
            text-decoration: none;
            font-size: 0.8rem;
            transition: background 0.3s;
        }

        .social-links a:hover {
            background-color: #C87D53;
        }

        .footer-bottom {
            text-align: center;
            padding-top: 20px;
            font-size: 0.8rem;
            color: #777;
        }

        @media (max-width: 850px) {
            .main-container {
                flex-direction: column;
            }
            .hero-content h1 {
                font-size: 2.2rem;
            }
            .main-nav ul {
                flex-wrap: wrap;
            }
        }
    </style>
